generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(64)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String?  @map("display_name") @db.VarChar(128)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("admin_users")
}

model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(64)
  value     String   @db.LongText
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

model ContentCard {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  subtitle    String?  @db.VarChar(512)
  body        String   @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(2048)
  linkLabel   String?  @map("link_label") @db.VarChar(128)
  linkUrl     String?  @map("link_url") @db.VarChar(2048)
  badge       String?  @db.VarChar(64)
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("content_cards")
}

model ServerHistoryEvent {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  body        String   @db.Text
  imageUrl    String?  @map("image_url") @db.VarChar(2048)
  eventDate   DateTime? @map("event_date")
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("server_history_events")
}

model TeamMember {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(128)
  role        String?  @db.VarChar(128)
  bio         String   @db.Text
  avatarUrl   String?  @map("avatar_url") @db.VarChar(2048)
  linkLabel   String?  @map("link_label") @db.VarChar(128)
  linkUrl     String?  @map("link_url") @db.VarChar(2048)
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("team_members")
}

model OpenSourceProject {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String   @db.Text
  url         String   @db.VarChar(2048)
  logoUrl     String?  @map("logo_url") @db.VarChar(2048)
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("open_source_projects")
}

model SiteAnnouncement {
  id           String    @id @default(cuid())
  title        String    @db.VarChar(255)
  body         String    @db.Text
  linkLabel    String?   @map("link_label") @db.VarChar(128)
  linkUrl      String?   @map("link_url") @db.VarChar(2048)
  announcedAt  DateTime? @map("announced_at")
  sortOrder    Int       @default(0) @map("sort_order")
  published    Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([sortOrder])
  @@index([published])
  @@map("site_announcements")
}
