# =============================================================================
# 环境变量示例（不含真实密钥，可提交到 Git）
#
# 使用：复制为同目录下的 .env 再修改
#   cp .env.example .env
#
# 切勿将 .env 提交到仓库（仓库 .gitignore 已忽略）。
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库（Prisma / MySQL）
# -----------------------------------------------------------------------------
# 格式：mysql://用户名:密码@主机:端口/数据库名
# 密码含 @ # 等字符时请做 URL 编码。
DATABASE_URL="mysql://sgu_site:changeme@127.0.0.1:3306/sgu_server_site"

# -----------------------------------------------------------------------------
# JWT 签名密钥（登录后写入 HttpOnly Cookie 的令牌由此签发/校验）
# -----------------------------------------------------------------------------
# 要求：至少 32 个字符；生产环境必须使用强随机串。
# 生成示例：openssl rand -base64 48
JWT_SECRET="please-replace-with-random-string-at-least-32-characters-long"

# -----------------------------------------------------------------------------
# 运行模式
# -----------------------------------------------------------------------------
# development — 本地开发
# production  — 生产：Cookie Secure、可托管 frontend/dist、Helmet HSTS 等
NODE_ENV="development"

# HTTP 监听端口（默认 4000）
PORT=4000

# -----------------------------------------------------------------------------
# 前端「来源」（CORS 允许的 Origin，须与浏览器地址栏一致）
# -----------------------------------------------------------------------------
# 本地 Vite：        http://localhost:5173
# 生产（示例）：     https://your-domain.com
# 注意：带不带 www、http/https 算不同来源，勿混用。
FRONTEND_ORIGIN="http://localhost:5173"

# -----------------------------------------------------------------------------
# 可选：前端构建产物目录（仅 NODE_ENV=production 且存在 index.html 时生效）
# -----------------------------------------------------------------------------
# 不设置则默认：相对当前工作目录的 ../frontend/dist（请在 backend 目录启动进程）
# FRONTEND_DIST="/absolute/path/to/frontend/dist"

# -----------------------------------------------------------------------------
# 可选：首次执行 npx prisma db seed 时的管理员账号（仅种子脚本读取）
# -----------------------------------------------------------------------------
# 部署到公网后请立即登录后台修改为强密码。
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme_after_first_login"
