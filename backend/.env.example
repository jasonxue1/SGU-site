# 复制本文件为 backend/.env 后填写真实值，切勿将 .env 提交到 Git。

# MySQL（Prisma）
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE"

# JWT，至少 32 字符的随机串
JWT_SECRET="请改为至少32字符的随机字符串_示例勿用于生产"

# 浏览器访问前端的来源（单一 URL，无通配符），开发示例：
# FRONTEND_ORIGIN="http://localhost:5173"
FRONTEND_ORIGIN="http://localhost:5173"

# 可选
# PORT=4000
# NODE_ENV=development
# FRONTEND_DIST=
# LISTEN_HOST=127.0.0.1

# 仅 prisma db seed 时使用（生产请改强密码并勿泄露）
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=请改为强密码
